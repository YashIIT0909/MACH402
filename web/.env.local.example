# Website configuration. Copy to web/.env.local.
#
# NOTE: anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript every
# visitor downloads. Treat all of it as published.

# The registry this site reads listings from. Server-side only.
REGISTRY_URL=http://localhost:4400

# ---------------------------------------------------------------------------
# Wallet — how a renter signs an x402 payment in the browser.
# ---------------------------------------------------------------------------

# WalletConnect / Reown project id. Free, from https://cloud.reown.com
# Without this the "Connect wallet" button is disabled and says so.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Dev key — a stand-in wallet for testing before a project id exists.
#
# This signs with a private key compiled into the page bundle, readable by
# anyone who loads the site. It exists so the rest of the flow (CORS, the 402,
# settlement, the tunnel link, extend and stop) can be proven without a wallet.
#
# Use a throwaway testnet account with a few HBAR. Never a real one. Leave
# NEXT_PUBLIC_DEV_WALLET unset in any deployment that is not your own laptop.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_DEV_WALLET=1
# NEXT_PUBLIC_DEV_WALLET_ACCOUNT_ID=0.0.0000000
# NEXT_PUBLIC_DEV_WALLET_KEY=
# NEXT_PUBLIC_DEV_WALLET_KEY_TYPE=ecdsa
