# Copy to .env and fill in. Never commit .env.

# Hex only, so it needs no escaping inside the database URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The public hostname for the registry, with a DNS A record pointing at this
# server. Caddy fetches its HTTPS certificate on first start. Leave unset to
# serve plain HTTP on port 80 while testing.
REGISTRY_DOMAIN=api.example.com

# Host ports. Change only if 80/443 are taken on this machine.
# HTTP_PORT=80
# HTTPS_PORT=443
