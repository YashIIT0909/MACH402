# Copy to .env and fill in. Never commit .env.

# The registry server's public URL, exactly as nodes and providers will use it.
REGISTRY_URL=https://api.example.com

# The public hostname for the website, with a DNS A record pointing at this
# server. Caddy fetches its HTTPS certificate on first start. Leave unset to
# serve plain HTTP on port 80 while testing.
WEB_DOMAIN=example.com

# Host ports. Change only if 80/443 are taken on this machine.
# HTTP_PORT=80
# HTTPS_PORT=443
