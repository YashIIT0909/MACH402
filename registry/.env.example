# The registry holds no keys and no money — it is discovery only.

# Matches registry/docker-compose.yml. Port 5433 so it cannot collide with a
# Postgres you already run on 5432.
DATABASE_URL=postgres://cleargate:cleargate@localhost:5433/cleargate

PORT=4400

# ---------------------------------------------------------------------------
# Cloudflare — optional, and only for interactive leases.
#
# Providers behind NAT cannot be reached for an SSH session or a notebook, so
# the registry provisions a Cloudflare tunnel on their behalf using the
# platform's own account. This is the ONLY place Cloudflare credentials are
# ever used: a provider never has a Cloudflare account and never sees anything
# but a token good for running their own one tunnel.
#
# Leave these unset and the registry still works — it answers 503 on
# /v1/nodes/:id/tunnel-token and nodes fall back to quick tunnels, which need
# no Cloudflare account at all (Jupyter works, SSH does not).
#
# To fill them in, once, as the platform operator:
#   1. a free Cloudflare account
#   2. a domain added to Cloudflare DNS, on the Free plan, showing "Active"
#   3. ZONE_ID from that domain's Overview page
#   4. My Profile -> API Tokens -> Create Custom Token, with
#      Account / Cloudflare Tunnel / Edit  and  Zone / DNS / Edit (that zone only)
#
# This is a server-side secret. It never goes to a provider or a renter.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# The zone leases are published under. Nodes get ssh-<id>.leases.<domain>,
# jupyter-<id>.leases.<domain> and api-<id>.leases.<domain>.
# LEASE_DOMAIN=cleargate-leases.xyz
