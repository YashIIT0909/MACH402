{
  "name": "cleargate",
  "version": "0.1.0",
  "private": true,
  "description": "GPU rental marketplace settled with x402 payments on Hedera",
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "smoke": "pnpm --filter @cleargate/smoke run smoke"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "@types/node": "22.20.2",
    "@cleargate/client": "workspace:*",
    "@cleargate/hederakit": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "keccak",
      "protobufjs",
      "secp256k1"
    ]
  }
}
