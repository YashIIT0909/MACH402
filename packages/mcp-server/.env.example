# Renter-side credentials. The only place this server's Hedera key lives —
# never sent to ClearGate, never written to disk beyond this file, never
# logged. See CLAUDE.md invariant 1.
#
# Get a funded testnet account at https://portal.hedera.com
HEDERA_ACCOUNT_ID=0.0.0000000
HEDERA_PRIVATE_KEY=

# Key type: ecdsa | ed25519. Portal ECDSA accounts use "ecdsa".
HEDERA_KEY_TYPE=ecdsa

# The ClearGate registry this agent searches for compute nodes. No default —
# point it at your own `make dev-registry` instance, or a registry your
# provider gave you.
CLEARGATE_REGISTRY_URL=http://localhost:4400

# --- Agent spend controls -----------------------------------------------
# A human isn't watching each call the way they watch the CLI, so these stand
# in for them.

# Refuse any single payment above this many tinybars. Default: 10000000
# (0.1 HBAR) if unset.
# CLEARGATE_MAX_TINYBARS_PER_PAYMENT=10000000

# Refuse a payment that would push today's total spend past this. Unset means
# no daily cap.
# CLEARGATE_MAX_TINYBARS_PER_DAY=100000000

# A single payment above this many tinybars pauses for the confirm_payment
# tool instead of executing immediately. Unset means payments never pause.
# CLEARGATE_CONFIRM_ABOVE_TINYBARS=20000000

# --- Records --------------------------------------------------------------
# Where this server's own spend ledger and audit log are written. Defaults
# below if unset. Kept separate from anything the `cleargate` CLI writes.
# CLEARGATE_MCP_RECEIPTS=~/.cleargate/mcp-receipts.jsonl
# CLEARGATE_MCP_AUDIT_LOG=~/.cleargate/mcp-audit.jsonl
