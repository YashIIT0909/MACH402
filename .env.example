# Renter-side credentials. Only the smoke test, the contract scripts and the parked
# escrow client read these; the website pays from the renter's own wallet.
# The agent never sees a private key — see CLAUDE.md invariant 1.
#
# Get a funded testnet account at https://portal.hedera.com
HEDERA_ACCOUNT_ID=0.0.0000000
HEDERA_PRIVATE_KEY=

# Key type: ecdsa | ed25519. Portal ECDSA accounts use "ecdsa".
HEDERA_KEY_TYPE=ecdsa

# Facilitator that co-signs as fee payer and submits to Hedera.
# Fallback: https://x402.org/facilitator
FACILITATOR_URL=https://api.testnet.blocky402.com

# Provider account that receives payment. Used by the smoke reference server
# and as the default `pay_to` when running `cleargate-node setup`.
PAY_TO_ACCOUNT_ID=0.0.0000000

# Smoke reference server
SMOKE_PORT=4402

# Hedera JSON-RPC relay, used only to deploy and exercise the contracts
# (`make contracts-deploy`, `make contracts-demo`). Nothing at runtime reads it:
# the node verifies deposits through the mirror node, and the renter's client
# submits contract calls through the Hedera SDK directly.
# HEDERA_RPC_URL=https://testnet.hashio.io/api

# Mirror node the contract scripts read. The provider node has its own setting
# for this in config.yaml (hedera.mirror_url).
# HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# NOTE: the provider's Hedera operator key is NOT here and never will be.
# It lives in a file beside the node's config.yaml (hedera.operator_key_path),
# generated by `cleargate-node setup --enable-hcs`, and is read only by the
# cleargate-hedera sidecar process. This file is renter-side credentials only.
