# The build context for both deploy images is the repo root, because the
# registry and the website depend on workspace packages (packages/types,
# client). Everything below is either rebuilt inside the image or has no
# business being in one.

**/node_modules
**/.next
**/dist
**/*.tsbuildinfo
**/*.log
.git
.github
.claude

# Secrets never enter an image; configuration comes from the environment.
**/.env
**/.env.*
!**/.env.example

# Not part of either image: the Go node, its build output, and contract
# build artefacts. contracts/package.json stays, because the lockfile names it.
agent
bin
marketplace
contracts/artifacts
contracts/cache
contracts/typechain-types
web/assets
receipts.jsonl
config.yaml
lease-ca
lease-ca.pub
hedera-operator
deploy
